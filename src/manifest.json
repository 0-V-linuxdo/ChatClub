{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "description": "__MSG_extDescription__",
  "version": "2.0.0",
  "default_locale": "zh_CN",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "tabs",
    "scripting",
    "webNavigation",
    "declarativeNetRequest",
    "cookies",
    "debugger",
    "alarms",
    "favicon",
    "clipboardRead",
    "clipboardWrite"
  ],
  "optional_permissions": ["userScripts"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "entries/background.js", "type": "module" },
  "action": { "default_title": "__MSG_extName__", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" } },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "sandbox": { "pages": ["sandbox.html"] },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'",
    "sandbox": "sandbox allow-scripts; default-src 'none'; script-src 'self' 'unsafe-eval'"
  }
}
